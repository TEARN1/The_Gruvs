# Branch previews for __APP__: https://<name>.__PREVIEW_DOMAIN__
# Installed by `vgruvs previews enable __APP__` once a wildcard certificate
# for *.__PREVIEW_DOMAIN__ exists. Previews are static only and are kept out
# of search engines.
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ~^(?<vgruvs_preview>[a-z0-9-]+)\.__PREVIEW_DOMAIN_RE__$;
    server_tokens off;

    root /srv/vgruvs/__APP__/previews/$vgruvs_preview__STATIC_SUFFIX__;
    index index.html;

    ssl_certificate /etc/letsencrypt/live/__PREVIEW_DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__PREVIEW_DOMAIN__/privkey.pem;
    include snippets/vgruvs-tls.conf;
    include snippets/vgruvs-gzip.conf;
    include snippets/vgruvs-headers.conf;
    add_header X-Robots-Tag "noindex, nofollow" always;

    location / { expires epoch; try_files $uri $uri/ /index.html =404; }
}
