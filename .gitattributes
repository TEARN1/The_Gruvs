# Normalise line endings so editors/tools stop churning CRLF<->LF in diffs.
* text=auto eol=lf

# Binary assets — never normalise.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
*.mp4   binary
*.mov   binary
*.pdf   binary