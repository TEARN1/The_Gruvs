{
  "expo": {
    "name": "The Gruvs",
    "slug": "the-gruvs",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/icon-512.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d1112"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.thegruvs.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "The Gruvs uses your location to show nearby events and vibers.",
        "NSCameraUsageDescription": "The Gruvs needs camera access to post event photos.",
        "NSPhotoLibraryUsageDescription": "The Gruvs needs photo library access to upload event media.",
        "NSMicrophoneUsageDescription": "The Gruvs uses the microphone for video recording.",
        "NSUserTrackingUsageDescription": "We use this to show you relevant events near you."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0d1112"
      },
      "package": "com.thegruvs.app",
      "versionCode": 1,
      "compileSdkVersion": 34,
      "targetSdkVersion": 34,
      "minSdkVersion": 21,
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "bundler": "metro",
      "name": "The Gruvs",
      "shortName": "Gruvs",
      "description": "Discover your next event. I got you.",
      "themeColor": "#0d1112",
      "backgroundColor": "#0d1112",
      "favicon": "./logo.jpg"
    },
    "plugins": [
      "expo-av",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "The Gruvs uses your location to show nearby events and vibers."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The Gruvs needs photo library access to upload event media.",
          "cameraPermission": "The Gruvs needs camera access to post event photos."
        }
      ]
    ],
    "extra": {
      "privacyPolicyUrl": "https://thegruvs.app/privacy",
      "eas": {
        "projectId": "5e0fd37e-d314-4074-96c9-3c6d8f474bc8"
      }
    },
    "owner": "tearn"
  }
}
