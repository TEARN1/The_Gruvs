{
  "expo": {
    "name": "The Gruvs",
    "slug": "the-gruvs",
    "scheme": "thegruvs",
    "version": "1.1.0",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/icon-512.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d1112"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.thegruvs.app",
      "buildNumber": "1",
      "associatedDomains": [
        "applinks:thegruvs.com",
        "applinks:www.thegruvs.com"
      ],
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "The Gruvs uses your location to show nearby events and vibers.",
        "NSCameraUsageDescription": "The Gruvs needs camera access to scan tickets and post event photos.",
        "NSPhotoLibraryUsageDescription": "The Gruvs needs photo library access to upload event media.",
        "NSMicrophoneUsageDescription": "The Gruvs uses the microphone for video recording.",
        "UIApplicationShortcutItems": [
          {
            "UIApplicationShortcutItemType": "com.thegruvs.app.search",
            "UIApplicationShortcutItemTitle": "Search Events",
            "UIApplicationShortcutItemIconType": "UIApplicationShortcutIconTypeSearch"
          },
          {
            "UIApplicationShortcutItemType": "com.thegruvs.app.createreel",
            "UIApplicationShortcutItemTitle": "Create Reel",
            "UIApplicationShortcutItemIconType": "UIApplicationShortcutIconTypeCaptureVideo"
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0d1112"
      },
      "package": "com.thegruvs.app",
      "versionCode": 3,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "thegruvs.com"
            },
            {
              "scheme": "https",
              "host": "www.thegruvs.com"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "name": "The Gruvs",
      "shortName": "Gruvs",
      "description": "Discover your next event. The ultimate event discovery platform — find gruvs, connect with vibers, and ride the vibe economy.",
      "themeColor": "#0d1112",
      "backgroundColor": "#0d1112",
      "favicon": "./logo.jpg",
      "lang": "en-ZA",
      "output": "single"
    },
    "plugins": [
      "expo-av",
      [
        "expo-camera",
        {
          "cameraPermission": "The Gruvs needs camera access to scan tickets and post event photos."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#00f2ff",
          "sounds": []
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "The Gruvs uses your location to show nearby events and vibers."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The Gruvs needs photo library access to upload event media.",
          "cameraPermission": "The Gruvs needs camera access to post event photos."
        }
      ],
      "expo-font",
      "expo-secure-store"
    ],
    "extra": {
      "privacyPolicyUrl": "https://thegruvs.com/privacy.html",
      "eas": {
        "projectId": "3a2292ca-e3ad-4741-85ce-5b9b859b1fb6"
      }
    },
    "owner": "tearn"
  }
}
