{
  "name": "the-gruvs-simple",
  "version": "1.1.0",
  "description": "",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "prebuild": "node scripts/check-bundle-health.js",
    "lint": "eslint .",
    "build": "npx expo export --platform web && npm run postbuild",
    "build:seo": "node scripts/build-seo-hubs.js && node scripts/gen-sitemap.js && node scripts/ping-indexnow.js",
    "ping:indexnow": "node scripts/ping-indexnow.js",
    "postbuild": "node -e \"const fs=require('fs'),path=require('path');const src=path.join(__dirname,'public','.well-known');const dst=path.join(__dirname,'dist','.well-known');if(fs.existsSync(src)){fs.mkdirSync(dst,{recursive:true});fs.readdirSync(src).forEach(f=>fs.copyFileSync(path.join(src,f),path.join(dst,f)));console.log('Copied .well-known to dist/');}\" && node scripts/inject-pwa.js && node scripts/build-seo-hubs.js && node scripts/gen-sitemap.js && node scripts/ping-indexnow.js",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report",
    "test:unit": "jest",
    "test:unit:watch": "jest --watch",
    "test:unit:coverage": "jest --coverage",
    "preflight": "node scripts/pre-deploy-check.js && node scripts/audit-schema.mjs && node scripts/audit-writes.mjs && node scripts/rpc-audit.js && node scripts/audit-indexes.mjs",
    "db:patch": "node scripts/apply-patch.js",
    "db:audit": "node scripts/db-audit.js",
    "deploy": "node scripts/pre-deploy-check.js && npm run build",
    "loadtest": "k6 run load/feed-stress.js",
    "monitor": "node scripts/monitor-errors.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "audit:writes": "node scripts/audit-writes.mjs",
    "audit:rpc": "node scripts/rpc-audit.js",
    "audit:indexes": "node scripts/audit-indexes.mjs",
    "audit:bounds": "node scripts/audit-query-bounds.mjs",
    "audit:contract": "node scripts/gen-db-contract.mjs",
    "db:ping": "node scripts/db-reachability.mjs",
    "audit:unused-functions": "node scripts/audit-unused-functions.mjs"
  },
  "jest": {
    "preset": "jest-expo",
    "forceExit": true,
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "testMatch": [
      "<rootDir>/__tests__/**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.claude/"
    ],
    "collectCoverageFrom": [
      "src/utils/**/*.js",
      "src/services/**/*.js",
      "src/components/**/*.js"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@config-plugins/react-native-webrtc": "^13.0.0",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@maplibre/maplibre-react-native": "^10.4.2",
    "@opentelemetry/api": "^1.9.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.110.0",
    "@types/react": "~19.1.10",
    "expo": "~54.0.38",
    "expo-av": "~16.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-calendar": "~15.0.8",
    "expo-camera": "~17.0.10",
    "expo-document-picker": "~14.0.8",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-local-authentication": "~17.0.9",
    "expo-location": "~19.0.8",
    "expo-media-library": "~18.2.1",
    "expo-network": "~8.0.8",
    "expo-notifications": "~0.32.17",
    "expo-secure-store": "~15.0.8",
    "expo-sensors": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "jest": "^29.4.0",
    "jest-expo": "~54.0.18",
    "maplibre-gl": "^4.7.1",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-maps": "1.20.1",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "~0.21.0",
    "react-native-webrtc": "^124.0.8",
    "typescript": "~5.8.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/react-native": "^13.3.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "pg": "^8.11.3",
    "react-test-renderer": "19.1.0"
  }
}
