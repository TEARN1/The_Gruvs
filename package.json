{
  "name": "the-gruvs-simple",
  "version": "1.1.0",
  "description": "",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "prebuild": "node scripts/check-bundle-health.js",
    "build": "npx expo export --platform web && npm run postbuild",
    "postbuild": "node -e \"const fs=require('fs'),path=require('path');const src=path.join(__dirname,'public','.well-known');const dst=path.join(__dirname,'dist','.well-known');if(fs.existsSync(src)){fs.mkdirSync(dst,{recursive:true});fs.readdirSync(src).forEach(f=>fs.copyFileSync(path.join(src,f),path.join(dst,f)));console.log('Copied .well-known to dist/');}\"",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report",
    "test:unit": "jest",
    "test:unit:watch": "jest --watch",
    "test:unit:coverage": "jest --coverage",
    "preflight": "node scripts/pre-deploy-check.js",
    "db:patch": "node scripts/apply-patch.js",
    "db:audit": "node scripts/db-audit.js",
    "deploy": "node scripts/pre-deploy-check.js && npm run build",
    "loadtest": "k6 run load/feed-stress.js",
    "monitor": "node scripts/monitor-errors.js"
  },
  "jest": {
    "preset": "jest-expo",
    "forceExit": true,
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/utils/**/*.js",
      "src/services/**/*.js",
      "src/components/**/*.js"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@expo/metro-runtime": "~3.2.1",
    "@expo/vector-icons": "^14.0.0",
    "@opentelemetry/api": "^1.9.1",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@supabase/supabase-js": "^2.110.0",
    "@types/react": "~18.2.79",
    "expo": "~51.0.0",
    "expo-av": "~14.0.5",
    "expo-calendar": "~13.0.5",
    "expo-camera": "^56.0.7",
    "expo-font": "~12.0.10",
    "expo-haptics": "~13.0.1",
    "expo-image": "~1.13.0",
    "expo-image-picker": "~15.1.0",
    "expo-local-authentication": "~14.0.1",
    "expo-location": "~17.0.1",
    "expo-media-library": "~16.0.5",
    "expo-network": "~6.0.1",
    "expo-notifications": "~0.28.19",
    "expo-secure-store": "~13.0.2",
    "expo-sensors": "~13.0.9",
    "expo-status-bar": "~1.12.1",
    "jest": "^29.4.0",
    "jest-expo": "~51.0.4",
    "qrcode": "^1.5.4",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.5",
    "react-native-maps": "1.14.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-safe-area-context": "4.10.5",
    "react-native-svg": "15.2.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "~0.19.10",
    "typescript": "~5.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/react-native": "^13.3.3",
    "pg": "^8.11.3",
    "react-test-renderer": "^18.2.0"
  }
}
