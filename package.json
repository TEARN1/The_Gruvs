{
  "name": "the-gruvs-simple",
  "version": "1.1.0",
  "description": "",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "prebuild": "node scripts/check-bundle-health.js",
    "lint": "eslint .",
    "build": "npx expo export --platform web && npm run postbuild",
    "postbuild": "node -e \"const fs=require('fs'),path=require('path');const src=path.join(__dirname,'public','.well-known');const dst=path.join(__dirname,'dist','.well-known');if(fs.existsSync(src)){fs.mkdirSync(dst,{recursive:true});fs.readdirSync(src).forEach(f=>fs.copyFileSync(path.join(src,f),path.join(dst,f)));console.log('Copied .well-known to dist/');}\" && node scripts/inject-pwa.js && node scripts/gen-sitemap.js",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report",
    "test:unit": "jest",
    "test:unit:watch": "jest --watch",
    "test:unit:coverage": "jest --coverage",
    "preflight": "node scripts/pre-deploy-check.js && node scripts/audit-schema.mjs && node scripts/audit-writes.mjs && node scripts/rpc-audit.js",
    "db:patch": "node scripts/apply-patch.js",
    "db:audit": "node scripts/db-audit.js",
    "deploy": "node scripts/pre-deploy-check.js && npm run build",
    "loadtest": "k6 run load/feed-stress.js",
    "monitor": "node scripts/monitor-errors.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "audit:writes": "node scripts/audit-writes.mjs",
    "audit:rpc": "node scripts/rpc-audit.js"
  },
  "jest": {
    "preset": "jest-expo",
    "forceExit": true,
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/utils/**/*.js",
      "src/services/**/*.js",
      "src/components/**/*.js"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@config-plugins/react-native-webrtc": "^10.0.0",
    "@expo/metro-runtime": "~4.0.1",
    "@expo/vector-icons": "~14.0.4",
    "@maplibre/maplibre-react-native": "^10.4.2",
    "@opentelemetry/api": "^1.9.1",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@supabase/supabase-js": "^2.110.0",
    "@types/react": "~18.3.12",
    "expo": "~52.0.0",
    "expo-av": "~15.0.2",
    "expo-calendar": "~14.0.6",
    "expo-camera": "~16.0.18",
    "expo-document-picker": "~13.0.3",
    "expo-font": "~13.0.4",
    "expo-haptics": "~14.0.1",
    "expo-image": "~2.0.7",
    "expo-image-picker": "~16.0.6",
    "expo-local-authentication": "~15.0.2",
    "expo-location": "~18.0.10",
    "expo-media-library": "~17.0.6",
    "expo-network": "~7.0.5",
    "expo-notifications": "~0.29.14",
    "expo-secure-store": "~14.0.1",
    "expo-sensors": "~14.0.2",
    "expo-status-bar": "~2.0.1",
    "jest": "^29.4.0",
    "jest-expo": "~52.0.6",
    "maplibre-gl": "^4.7.1",
    "qrcode": "^1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-maps": "1.18.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-safe-area-context": "4.12.0",
    "react-native-svg": "15.8.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "~0.19.10",
    "react-native-webrtc": "^124.0.0",
    "typescript": "~5.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/react-native": "^13.3.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "pg": "^8.11.3",
    "react-test-renderer": "^18.2.0"
  }
}
