# ─── Required — app will not start without these ─────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key



# ─── App URLs ────────────────────────────────────────────────────────────────
EXPO_PUBLIC_APP_URL=https://your-app.vercel.app
EXPO_PUBLIC_FUNCTIONS_URL=https://your-project.supabase.co/functions/v1

# ─── Music integrations (optional) ──────────────────────────────────────────
# SECURITY: every EXPO_PUBLIC_* var is compiled into the public web/app bundle,
# so NEVER put a secret here. The Spotify CLIENT SECRET must live ONLY in the
# Supabase Edge Function ('spotify-token') environment — the app fetches a token
# from that function and never sees the secret. The client ID is not sensitive.
#   → In your real .env, DELETE any EXPO_PUBLIC_SPOTIFY_CLIENT_SECRET line; it
#     ships in the bundle even if no code reads it. Set SPOTIFY_CLIENT_SECRET on
#     the edge function instead (supabase secrets set / dashboard).
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=your-spotify-client-id
# A YouTube Data API key bundles client-side too — restrict it by HTTP referrer /
# app package + set a tight quota in the Google Cloud console, or move it server-side.
EXPO_PUBLIC_YOUTUBE_API_KEY=your-youtube-api-key
