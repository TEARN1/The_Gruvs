# ─── Required — app will not start without these ─────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ─── AI (Claude / Anthropic) ─────────────────────────────────────────────────
# Set to "claude" to use Anthropic API, "local" for a local model, or leave blank to disable AI
EXPO_PUBLIC_AI_BACKEND=claude
ANTHROPIC_API_KEY=sk-ant-...

# ─── Local AI (optional — only if EXPO_PUBLIC_AI_BACKEND=local) ──────────────
EXPO_PUBLIC_AI_LOCAL_URL=http://localhost:11434/v1/chat/completions
EXPO_PUBLIC_AI_LOCAL_MODEL=gpt-4o-mini

# ─── App URLs ────────────────────────────────────────────────────────────────
EXPO_PUBLIC_APP_URL=https://your-app.vercel.app
EXPO_PUBLIC_FUNCTIONS_URL=https://your-project.supabase.co/functions/v1

# ─── Music integrations (optional) ──────────────────────────────────────────
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=your-spotify-client-id
EXPO_PUBLIC_SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
EXPO_PUBLIC_YOUTUBE_API_KEY=your-youtube-api-key
